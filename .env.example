# Backend (FastAPI) environment. Copy to .env or set on Render.
# Nothing here is ever sent to the browser.

# ---- Required in production (startup refuses to boot without them) ----------
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ALLOWED_ORIGINS=https://your-web-app.vercel.app        # comma-separated, no "*"
DATABASE_URL=postgresql://user:pass@host:5432/dbname    # unset -> local SQLite
ENVIRONMENT=production                                   # dev | production

# ---- Administrators (bootstrap) ---------------------------------------------
# Comma-separated emails promoted to ADMIN at startup / sign-in. After the first
# admin exists, use the Admin dashboard to assign roles instead.
ADMIN_EMAILS=you@your-institution.org

# ---- Email (password resets, invitations) ----------------------------------
EMAIL_BACKEND=auto            # auto | smtp | console (auto = smtp when SMTP_HOST set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
EMAIL_FROM=                   # defaults to SUPPORT_EMAIL
APP_BASE_URL=https://your-web-app.vercel.app   # used to build links in emails
# QGUIDE_DEV_EMAIL=1          # DEV ONLY: return reset tokens in the API when no SMTP

# ---- Branding (optional; defaults in qguide/app/branding.py) ---------------
# APP_NAME=QGuide
# APP_SHORT_NAME=QGuide
# APP_DESCRIPTION=
# APP_TAGLINE=
# APP_LOGO_MARK=Q
# APP_LOGO_URL=
# SUPPORT_EMAIL=support@qguide.bio
# LEGAL_COMPANY_NAME=QGuide
# APP_WEBSITE_URL=
# APP_DOCS_URL=

# ---- Rate limits (optional) -------------------------------------------------
# LOGIN_RATE_LIMIT=10          # attempts per LOGIN_RATE_WINDOW per ip+email
# LOGIN_RATE_WINDOW=300
# SIGNUP_RATE_LIMIT=5          # per 10 minutes per ip+email
