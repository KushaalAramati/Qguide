# Copy to .env.local for local dev. In Vercel, set NEXT_PUBLIC_API_URL to your
# backend URL (e.g. https://qguide-api.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Branding (all optional; defaults live in lib/branding.ts) --------------
# Change these (and the matching backend APP_* vars) to rebrand without code edits.
# NEXT_PUBLIC_APP_NAME=QGuide
# NEXT_PUBLIC_APP_SHORT_NAME=QGuide
# NEXT_PUBLIC_APP_TAGLINE=Explainable, outcome-first CRISPR guide design
# NEXT_PUBLIC_APP_DESCRIPTION=Context-aware, explainable CRISPR guide RNA design and analysis.
# NEXT_PUBLIC_APP_LOGO_MARK=Q
# NEXT_PUBLIC_APP_LOGO_URL=
# NEXT_PUBLIC_SUPPORT_EMAIL=support@qguide.bio
# NEXT_PUBLIC_LEGAL_COMPANY_NAME=QGuide
# NEXT_PUBLIC_APP_WEBSITE_URL=
# NEXT_PUBLIC_APP_DOCS_URL=
